@echo off
setlocal

set "TMP_PS1=%TEMP%\transpro-speedtest-%RANDOM%.ps1"

powershell -ExecutionPolicy Bypass -NoProfile -Command "[System.IO.File]::WriteAllBytes('%TMP_PS1%', [System.Convert]::FromBase64String(''))"

if not exist "%TMP_PS1%" (
    echo ERROR: Could not create temp script.
    pause
    exit /b 1
)

powershell -ExecutionPolicy Bypass -NoProfile -File "%TMP_PS1%"
del "%TMP_PS1%" 2>nul
